# Deployment shell only. Never load this file into API/worker systemd units.
# Store the production copy outside the repo with mode 0600, for example:
#   /home/ubuntu/.config/bulls/migration.env
MIGRATION_DATABASE_URL=postgresql+asyncpg://bulls:OWNER_PASSWORD@127.0.0.1:5432/bulls
APP_DATABASE_PASSWORD=RANDOM_RUNTIME_PASSWORD_AT_LEAST_32_CHARACTERS
