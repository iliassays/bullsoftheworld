# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
ENV=local
LOG_LEVEL=INFO

# --- Postgres (with pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=bulls
POSTGRES_PASSWORD=bulls
POSTGRES_DB=bulls
# Async SQLAlchemy URL (asyncpg driver). Host port 5433 avoids clashing with a local pg on 5432.
DATABASE_URL=postgresql+asyncpg://bulls:bulls@localhost:5433/bulls
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_S=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- Redis (cache, pub/sub, arq queue) ---
REDIS_URL=redis://localhost:6379/0
AI_QUEUE_NAME=arq:ai
DSE_INGESTION_QUEUE_NAME=arq:ingestion:dse
US_INGESTION_QUEUE_NAME=arq:ingestion:us
SEC_INGESTION_QUEUE_NAME=arq:ingestion:sec
US_EOD_MIN_COVERAGE=0.90
# SEC fair-access identity; must be a monitored inbox and is sent in every EDGAR request.
SEC_CONTACT_EMAIL=hello@bullsofwallst.com

# --- AI ---
# Provider for LLM-only jobs: "disabled", "claude", or "ollama". Disabled costs nothing and is
# the production default; deterministic research and local FastEmbed RAG still work.
AI_PROVIDER=disabled

# Retrieval embeddings for Ask This Stock.
# "fastembed" = free local semantic embeddings, no OpenAI/Claude/Ollama bill. It downloads the
# configured ONNX model into AI_EMBEDDING_CACHE_DIR on first use and runs in the worker/backfill path.
# "hash" is a local/test-only fallback; "openai"/"ollama" are opt-in.
AI_EMBEDDING_PROVIDER=fastembed
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
AI_EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_CACHE_DIR=.cache/fastembed
AI_EMBEDDING_API_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=

# Optional local LLM/embedding service — only used when AI_PROVIDER=ollama or
# AI_EMBEDDING_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# Claude (paid) — used only when AI_PROVIDER=claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Auth ---
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=60
REFRESH_COOKIE_NAME=bulls_refresh
REFRESH_COOKIE_SAMESITE=lax
# Shared token guarding /admin routes (sent as X-Admin-Token header). Empty = admin locked.
ADMIN_TOKEN=

# --- Tenancy ---
# Default tenant when a request has no resolvable host (local dev).
DEFAULT_TENANT=bullsofdhaka
STRICT_TENANT_RESOLUTION=true
# Browser origins allowed to call the shared API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bullsofdhaka.com,https://www.bullsofdhaka.com,https://bullsofwallst.com,https://www.bullsofwallst.com

# --- Operations ---
API_PUBLIC_URL=http://localhost:8090
WALLST_API_PUBLIC_URL=https://api.bullsofwallst.com
SUPPORT_EMAIL=hello@bullsofdhaka.com
ALERT_EMAIL=
# Optional tenant-specific SEC alert routing; falls back to ALERT_EMAIL, then SUPPORT_EMAIL.
WALLST_ALERT_EMAIL=
EMAIL_FROM="Bulls of Dhaka <no-reply@bullsofdhaka.com>"
RESEND_API_KEY=
