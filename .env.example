# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
ENV=local
LOG_LEVEL=INFO

# --- Postgres (with pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bulls
POSTGRES_PASSWORD=bulls
POSTGRES_DB=bulls
# Async SQLAlchemy URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://bulls:bulls@localhost:5432/bulls

# --- Redis (cache, pub/sub, arq queue) ---
REDIS_URL=redis://localhost:6379/0

# --- AI (Claude) ---
ANTHROPIC_API_KEY=
# Default model — keep current; see /claude-api skill for ids
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Auth ---
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=60

# --- Tenancy ---
# Default tenant when a request has no resolvable host (local dev).
DEFAULT_TENANT=bullsofdhaka
