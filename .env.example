# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
ENV=local
LOG_LEVEL=INFO

# --- Postgres (with pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=bulls
POSTGRES_PASSWORD=bulls
POSTGRES_DB=bulls
# Async SQLAlchemy URL (asyncpg driver). Host port 5433 avoids clashing with a local pg on 5432.
DATABASE_URL=postgresql+asyncpg://bulls:bulls@localhost:5433/bulls

# --- Redis (cache, pub/sub, arq queue) ---
REDIS_URL=redis://localhost:6379/0

# --- AI ---
# Provider: "ollama" (free, local — needs Ollama running) or "claude" (needs a key).
AI_PROVIDER=ollama

# Local (free) — install Ollama + `ollama pull qwen2.5`. qwen2.5/aya handle Bangla best.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# Claude (paid) — used only when AI_PROVIDER=claude. haiku is cheaper for high-volume tagging.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Auth ---
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=60

# --- Tenancy ---
# Default tenant when a request has no resolvable host (local dev).
DEFAULT_TENANT=bullsofdhaka
