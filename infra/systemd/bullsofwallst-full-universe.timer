[Unit]
Description=Continue complete US research onboarding after the DSE close

[Timer]
OnCalendar=*-*-* 09:15:00 UTC
# Ten-minute gaps between two-hour bounded runs keep checkpoint cleanup and unit turnover clear.
# The shared flock prevents this catalog worker from overlapping the priority cohort worker.
OnCalendar=Sat,Sun *-*-* 00:15:00 UTC
OnCalendar=Sat,Sun *-*-* 02:30:00 UTC
OnCalendar=Sat,Sun *-*-* 04:45:00 UTC
OnCalendar=Sat,Sun *-*-* 07:00:00 UTC
OnCalendar=Sat,Sun *-*-* 09:15:00 UTC
OnCalendar=Sat,Sun *-*-* 11:30:00 UTC
OnCalendar=Sat,Sun *-*-* 13:45:00 UTC
OnCalendar=Sat,Sun *-*-* 16:00:00 UTC
OnCalendar=Sat,Sun *-*-* 18:15:00 UTC
OnCalendar=Sat,Sun *-*-* 20:30:00 UTC
OnCalendar=Sat,Sun *-*-* 22:45:00 UTC
AccuracySec=2min
Persistent=true

[Install]
WantedBy=timers.target
