[Unit]
Description=Bulls of Wall Street official SEC ingestion worker
After=network-online.target redis-server.service bullsofdhaka-api.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bullsofdhaka/services/ingestion
EnvironmentFile=/home/ubuntu/bullsofdhaka/.env
Environment=BULLS_SEC_13F_CACHE_DIR=/home/ubuntu/bullsofdhaka/var/sec-13f-cache
ExecStart=/home/ubuntu/bullsofdhaka/.venv/bin/arq ingestion.sec_worker.WorkerSettings
Restart=always
RestartSec=10
TimeoutStopSec=60
# Preserve API capacity when official archives are decompressed and reconciled.
Nice=10
CPUWeight=20
IOWeight=20
MemoryHigh=1536M
MemoryMax=2560M
OOMScoreAdjust=500
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
