[Unit]
Description=Bulls of the World AI and embedding worker
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bullsofdhaka/services/ai_worker
EnvironmentFile=/home/ubuntu/bullsofdhaka/.env
ExecStart=/home/ubuntu/bullsofdhaka/.venv/bin/arq ai_worker.worker.WorkerSettings
Restart=always
RestartSec=5
TimeoutStopSec=30
# Embedding backlogs are throughput work and must yield to API traffic.
Nice=10
CPUWeight=20
IOWeight=20
MemoryHigh=1536M
MemoryMax=2560M
OOMScoreAdjust=500
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
